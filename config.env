#####################################################################
# Configuration file used by the Makefile to work with your project #
#####################################################################

# Azure Machine Learning workspace the Makefile will point to
WORKSPACE=explore-pi
# Azure Machine Learning resource group the Makefile will point to
RESOURCE_GROUP=azml-pi
# Relative folder where experiments live (job spec, run script and Docker environment per experiment)
CODE_PATH=./azureml
# Relative folder where runs are isolated before running locally or submitting to Azure ML
ISOLATED_RUNS_PATH=./azureml/isolated_runs
# Azure CLI extension folder holding only the v2 `ml` extension. The system folder also has the legacy v1
# `azure-cli-ml`, which takes over `az ml`. Set up with: AZURE_EXTENSION_DIR=~/.azure/cliextensions az extension add -n ml
AZURE_EXTENSION_DIR=$(HOME)/.azure/cliextensions
